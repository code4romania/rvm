{
    "name": "code4romania/rvm",
    "type": "project",
    "description": "A management system for volunteers and resources in case of an earthquake.",
    "keywords": [
        "code4romania",
        "laravel",
        "resource",
        "volunteer",
        "management"
    ],
    "license": "MPL-2.0",
    "require": {
        "php": "^8.1",
        "alcea/cnp": "^3.0",
        "dedoc/scramble": "^0.13",
        "filament/filament": "^5.0",
        "filament/spatie-laravel-media-library-plugin": "^5.0",
        "guzzlehttp/guzzle": "^8.6",
        "jeffgreco13/filament-breezy": "^3.0",
        "laravel/framework": "^13.0",
        "laravel/sanctum": "^4.5",
        "laravel/tinker": "^3.0",
        "league/flysystem-aws-s3-v3": "^3.30",
        "pxlrbt/filament-excel": "^3.0",
        "sentry/sentry-laravel": "^4.31",
        "spatie/laravel-query-builder": "^6.3"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^3.8",
        "fakerphp/faker": "^1.24",
        "friendsofphp/php-cs-fixer": "^3.95",
        "fruitcake/laravel-debugbar": "^4.4",
        "itsgoingd/clockwork": "^5.3",
        "laravel/sail": "^1.71",
        "laravel/telescope": "^5.29",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "nunomaduro/termwind": "^2.0",
        "pestphp/pest": "^4.0",
        "phpunit/phpunit": "^12.0",
        "spatie/laravel-ignition": "^2.13"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-install-cmd": [
            "@php artisan filament:assets"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan filament:upgrade",
            "@php artisan ide-helper:generate",
            "@php artisan ide-helper:meta",
            "@php artisan ide-helper:models --nowrite"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "test": "@php artisan test"
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
